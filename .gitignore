# ---- Secrets (never commit; keep only *.example) ----
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ---- Database data / dumps (never push the DB) ----
*.dump
*.sql
!db/**/*.sql
*.csv
*.sqlite
*.sqlite3
pgdata/
backups/

# ---- ETL artefacts ----
raw_cache/
logs/
*.log

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.eggs/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- Node / frontend ----
node_modules/
frontend/dist/
dist/
.vite/
*.tsbuildinfo
coverage/
.pnpm-store/
npm-debug.log*
pnpm-debug.log*

# ---- Playwright ----
playwright-report/
test-results/
.playwright/

# ---- Docker ----
docker-compose.override.yml

# ---- Editors / OS ----
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# ---- Claude Code local settings ----
.claude/settings.local.json

# ---- Design extraction dumps (decide: keep tokens, ignore big dumps) ----
doop/**/*_dump.json
doop/**/*_extracted.json
