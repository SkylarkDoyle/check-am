# CheckAm Frontend Environment Variables

# Base URL for the CheckAm backend API (including /api/v1 path).
# In local development: '/api/v1' uses the Vite dev proxy to localhost:8000.
# In production (e.g. Cloudflare Pages): set this to your deployed FastAPI backend URL, e.g.:

VITE_API_BASE_URL=/api/v1

# Design review only, normally OFF. Set to 1 to show the AI lookup with canned answers and no
# backend (also try /search?q=colgate&ai=loading|result|nothing|limit). Leave unset for real use:
# the AI card then appears only when the API is running and has a SERPAPI_API_KEY.
# VITE_AI_FIXTURES=1
