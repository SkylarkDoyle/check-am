# CheckAm backend settings. Copy this file to backend/.env (which is gitignored) and edit.
# Read by backend/app/settings.py. Every value has a safe default, so only set what you change.
# Never commit real passwords, database URLs or API keys.

# --- Database -------------------------------------------------------------------------------
# Local Postgres (or the docker compose db on port 5433). Production: the Neon POOLED url.
DATABASE_URL=postgresql://checkam:change-me@localhost:5432/checkam
# Optional separate database for tests (leave empty to use DATABASE_URL).
TEST_DATABASE_URL=
# Connections kept per API process. Keep small on Neon free + FastAPI Cloud Nano.
DB_POOL_MIN=1
DB_POOL_MAX=5

# --- Server ---------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
# Browser origins allowed to call the API. A JSON list. Production: your Cloudflare Pages URL.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
RATE_LIMIT_PER_MINUTE=60

# --- AI lookup (optional) -------------------------------------------------------------------
# SerpApi key for Google AI Mode. Empty = the feature is OFF and the app hides the AI card.
# Backend only: never put this in the frontend or commit it.
SERPAPI_API_KEY=
AI_LOOKUP_ENABLED=true
# Lookups per day: per device (random id from the browser), per IP (generous backstop, carriers
# share IPs) and for the whole app (protects your SerpApi quota and bill).
AI_DAILY_LIMIT_PER_DEVICE=5
AI_DAILY_LIMIT_PER_IP=60
AI_DAILY_LIMIT_GLOBAL=100
# How long answers are cached: real answers, and "nothing reliable found".
AI_CACHE_TTL_DAYS=30
AI_NONE_TTL_DAYS=7
# Provider timeouts in seconds, and the prompt wording version (change it to refresh the cache).
AI_TIMEOUT_SECONDS=25
AI_POLL_SECONDS=20
AI_PROMPT_VERSION=2
# Salt for hashing IPs into the daily counter. Use a random string in production.
AI_IP_SALT=change-me
