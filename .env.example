DATABASE_URL=postgresql+psycopg://checkam:change-me@localhost:5432/checkam
POSTGRES_PASSWORD=change-me
ETL_CONTACT_EMAIL=you@example.com
ETL_USER_AGENT=CheckAmETL/0.1 (+mailto:${ETL_CONTACT_EMAIL})
ETL_MIN_DELAY_SECONDS=2
ETL_RAW_CACHE_DIR=./raw_cache
GREENBOOK_ENDPOINT=
ALERT_WEBHOOK_URL=

# Neon (production). Never commit real values.
# NEON_POOLED_URL (host has -pooler): set as DATABASE_URL on FastAPI Cloud for the API.
# NEON_DIRECT_URL: Alembic migrations and ETL (`run --target neon`).
NEON_POOLED_URL=
NEON_DIRECT_URL=

# API pool size (backend). Keep small on Neon free + FastAPI Cloud Nano.
DB_POOL_MIN=1
DB_POOL_MAX=5

# docker compose (host ports; POSTGRES_PASSWORD above is used by the compose db).
# Keep POSTGRES_PASSWORD URL-safe (letters/digits), it is embedded in connection URLs.
DB_PORT=5433
API_PORT=8000
WEB_PORT=8080